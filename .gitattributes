# Keep text files LF in the repo and working tree (Unity and our scripts write LF).
* text=auto eol=lf

# Binary assets: never diff or convert line endings.
*.png binary
*.jpg binary
*.tga binary
*.psd binary
*.ogg binary
*.wav binary
*.mp3 binary
*.glb binary
*.fbx binary
*.blend binary
*.asset -text merge=unityyamlmerge diff
*.unity -text merge=unityyamlmerge diff
*.prefab -text merge=unityyamlmerge diff
*.mat -text merge=unityyamlmerge diff
